# Microsoft Foundry: endpoint do PROJETO (Portal do Foundry > projeto > Visão geral)
FOUNDRY_PROJECT_ENDPOINT=https://<recurso>.services.ai.azure.com/api/projects/<projeto>

# Nome do DEPLOYMENT do modelo no projeto (não o nome do modelo base)
# Slide 15: modelo caro em tarefa trivial multiplica a fatura por passo.
FOUNDRY_MODEL=gpt-5.4

# Autenticação: rode `az login` antes. Nenhuma chave de API fica neste arquivo.
