# Opção A: Gemini API (Google AI Studio -> https://aistudio.google.com/apikey)
GOOGLE_GENAI_USE_VERTEXAI=FALSE
GOOGLE_API_KEY=cole-sua-chave-aqui

# Opção B: Vertex AI (troque as linhas acima por estas e rode `gcloud auth application-default login`)
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=seu-projeto
# GOOGLE_CLOUD_LOCATION=us-central1

# Modelo. Slide 15: modelo caro em tarefa trivial multiplica a fatura por passo.
GOOGLE_MODEL=gemini-3.5-flash

# Slide 18: limite do laço. No ADK ele é do runtime, não do agente.
# `adk web --max_llm_calls 8` tem precedência; esta variável é o padrão quando a flag não vem.
ADK_MAX_LLM_CALLS=8

# O ADK tenta mTLS em toda conexão MCP e, para isso, carrega o login padrão do gcloud (ADC).
# O servidor da Triagen é público: desligar evita que o agente toque numa credencial que não usa.
GOOGLE_API_USE_CLIENT_CERTIFICATE=false
