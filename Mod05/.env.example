# Copie este arquivo para .env (aqui mesmo, na pasta Cap05) e preencha com os dados do SEU ambiente.
# Os notebooks leem o .env automaticamente; o que faltar é perguntado na hora da execução.
# O .env guarda chaves: não compartilhe e não versione.

# ---------------------------------------------------------------------------
# Azure OpenAI (todos os exemplos)
# ---------------------------------------------------------------------------
# Use o formato https://<recurso>.openai.azure.com: o vetorizador do AI Search exige esse formato.
AZURE_OPENAI_ENDPOINT=https://<recurso>.openai.azure.com
AZURE_OPENAI_API_KEY=
# Nome do deployment de chat (o mesmo usado no Cap. 1). Ex.: gpt-5-mini
AZURE_OPENAI_DEPLOYMENT=
# Nome do deployment de embedding e o modelo que está por trás dele.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Dimensão do vetor. Indexação e consulta precisam usar o mesmo valor.
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# ---------------------------------------------------------------------------
# Azure AI Search (tipos-de-rag e bases-vetoriais/01-ai-search)
# ---------------------------------------------------------------------------
# Recomendado: tier Basic ou superior. O semantic ranker e o knowledge base (agentic retrieval) já vêm
# no plano gratuito, com cota mensal; passar da cota exige o plano Standard, do Basic para cima.
# Confira se a região do serviço oferece esses recursos.
AZURE_SEARCH_ENDPOINT=https://<servico>.search.windows.net
# Chave de administração (os notebooks criam índices).
AZURE_SEARCH_API_KEY=

# ---------------------------------------------------------------------------
# Bases vetoriais (preencha só a que for usar)
# ---------------------------------------------------------------------------
# Azure Cosmos DB for NoSQL, com a busca vetorial habilitada na conta.
AZURE_COSMOS_ENDPOINT=https://<conta>.documents.azure.com:443/
AZURE_COSMOS_KEY=

# Azure Database for PostgreSQL (servidor flexível), com a extensão VECTOR liberada em azure.extensions.
AZURE_POSTGRES_CONNECTION_STRING="host=<servidor>.postgres.database.azure.com port=5432 dbname=postgres user=<usuario> password=<senha> sslmode=require"

# Azure SQL Database. Ajuste o nome do driver ODBC instalado na sua máquina (17 ou 18).
AZURE_SQL_CONNECTION_STRING="Driver={ODBC Driver 18 for SQL Server};Server=tcp:<servidor>.database.windows.net,1433;Database=<banco>;Uid=<usuario>;Pwd=<senha>;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;"

# Azure Managed Redis, criado com o módulo RediSearch.
AZURE_REDIS_HOST=<cache>.<regiao>.redis.azure.net
AZURE_REDIS_PORT=10000
AZURE_REDIS_KEY=

# Azure DocumentDB (compatível com MongoDB).
AZURE_DOCUMENTDB_CONNECTION_STRING="mongodb+srv://<usuario>:<senha>@<cluster>.mongocluster.cosmos.azure.com/?tls=true&authMechanism=SCRAM-SHA-256&retrywrites=false&maxIdleTimeMS=120000"
